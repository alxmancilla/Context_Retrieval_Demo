MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_DB=ai_context_demo
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=60000
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_VALIDATION_ACTION=warn
APP_ENV=local
CHAT_PROVIDER=grove
GROVE_API_KEY=<grove-api-key>
GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1
GROVE_MODEL=gpt-5.6-sol
GROVE_TIMEOUT_SECONDS=60
GROVE_MAX_RETRIES=2
OPENAI_API_KEY=<openai-api-key>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
VOYAGE_API_KEY=<voyage-api-key>
VOYAGE_RERANK_MODEL=rerank-3
VOYAGE_RERANK_TIMEOUT_SECONDS=15
VOYAGE_RERANK_MAX_RETRIES=2
LOG_LEVEL=INFO
REALM_ID=ai-demo
USER_ID=demo-user
ACCESS_PRINCIPALS=role:platform-engineer
AUTH_MODE=disabled
OAUTH_ALLOWED_PROVIDERS=
OAUTH_REALM_CLAIM=realm_id
OAUTH_PRINCIPALS_CLAIM=groups
OAUTH_GROUP_PREFIX=group:
AUTH_USERNAME=<local-demo-username>
AUTH_PASSWORD=<local-demo-password>
CHAINLIT_AUTH_SECRET=<generate-a-long-random-secret>
AGENT_ID=ai-context-assistant
SOURCE_TOP_K=5
SOURCE_RETRIEVAL_MODE=hybrid
MEMORY_TOP_K=3
MEMORY_RETENTION_DAYS=30
MEMORY_MAX_PER_USER=100
MEMORY_MIN_IMPORTANCE=0.65
MEMORY_SIMILARITY_THRESHOLD=0.92
MEMORY_EMBEDDING_PROFILE=voyage-4:auto-embed:v1
PROMPT_VERSION=answer-v2
AGENT_VERSION=memory-v2
RECENT_CONTEXT_MESSAGES=6
RECENT_CONTEXT_MAX_CHARS=4000
CONVERSATION_SUMMARY_MAX_CHARS=1500
CHECKPOINT_RETENTION_DAYS=7
RECONCILIATION_VECTOR_WEIGHT=0.55
RECONCILIATION_AUTHORITY_WEIGHT=0.30
RECONCILIATION_FRESHNESS_WEIGHT=0.15
