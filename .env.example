MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_DB=ai_context_demo
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=60000
APP_ENV=local
GROVE_API_KEY=<grove-api-key>
GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1
GROVE_MODEL=gpt-5.6-sol
GROVE_TIMEOUT_SECONDS=60
GROVE_MAX_RETRIES=2
VOYAGE_API_KEY=<voyage-api-key>
VOYAGE_RERANK_MODEL=rerank-2.5
VOYAGE_RERANK_TIMEOUT_SECONDS=15
VOYAGE_RERANK_MAX_RETRIES=2
LOG_LEVEL=INFO
REALM_ID=ai-demo
USER_ID=demo-user
ACCESS_PRINCIPALS=role:platform-engineer
AUTH_MODE=disabled
AUTH_USERNAME=<local-demo-username>
AUTH_PASSWORD=<local-demo-password>
CHAINLIT_AUTH_SECRET=<generate-a-long-random-secret>
AGENT_ID=ai-context-assistant
SOURCE_TOP_K=5
MEMORY_TOP_K=3
MEMORY_RETENTION_DAYS=30
MEMORY_MAX_PER_USER=100
CHECKPOINT_RETENTION_DAYS=7
RECONCILIATION_VECTOR_WEIGHT=0.55
RECONCILIATION_AUTHORITY_WEIGHT=0.30
RECONCILIATION_FRESHNESS_WEIGHT=0.15
